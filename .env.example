# Database. SQLite by default; for PostgreSQL set provider = "postgresql" in
# prisma/schema.prisma and point this at your instance, e.g.
# postgresql://user:pass@localhost:5432/imi
DATABASE_URL="file:./dev.db"

# Signs the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# Admin login. Generate the hash line with:  npm run admin:hash -- "your-password"
# and paste it over the one below. The backslashes matter: Next.js expands
# unescaped `$` when it reads .env files, which would corrupt the bcrypt hash.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="\$2b\$12\$replaceThisWithTheHashFromTheAdminHashScript"
